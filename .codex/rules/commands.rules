# User rules from ~/.claude/settings.json.
# The harness allows branch changes, pushes and PR actions. AGENTS.md says when to ask first.
# When rules overlap, the strictest one wins.
prefix_rule(pattern = ["git", ["branch", "switch", "push"]], decision = "allow")
prefix_rule(pattern = ["git", ["checkout", "reset"]], decision = "prompt")
prefix_rule(pattern = ["git", "push", ["-f", "--force", "--force-with-lease", "--force-if-includes"]], decision = "forbidden")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden")
prefix_rule(pattern = ["git", "clean"], decision = "forbidden")

prefix_rule(pattern = ["gh", "pr"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "merge"], decision = "prompt")
prefix_rule(pattern = ["gh", "issue"], decision = "allow")
