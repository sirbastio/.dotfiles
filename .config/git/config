[user]
    name = Phillipe Sebastiao
    email = phillipe.sebastiao@gmail.com

[init]
    defaultBranch = main

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    line-numbers = true
    true-color = always
    syntax-theme = github-dark-default
    minus-style = syntax "#2c171b"
    minus-emph-style = syntax "#5f2022"
    plus-style = syntax "#10231c"
    plus-emph-style = syntax "#164023"
    line-numbers-zero-style = "#6e7681"
    line-numbers-plus-style = "#6e7681"
    line-numbers-left-format = ""
    line-numbers-right-format = "{np:>4} "
    file-style = bold "#e6edf3"
    file-decoration-style = "#30363d" ul ol
    hunk-header-decoration-style = none
    hunk-header-style = syntax
    file-added-label = "[38;2;63;185;80m[38;2;230;237;243m"
    file-modified-label = "[38;2;210;153;34m[38;2;230;237;243m"
    file-removed-label = "[38;2;248;81;73m[38;2;230;237;243m"
    file-renamed-label = "[38;2;88;166;255m[38;2;230;237;243m"
